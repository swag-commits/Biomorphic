# ─────────────────────────────────────────────────────────────────────────────
# Biomorphic — local environment variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres / Supabase ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=biomorphic_local
SUPABASE_URL=http://localhost:3000
SUPABASE_DB_URL=postgresql://postgres:biomorphic_local@localhost:5432/biomorphic

# ── JWT (local dev only — change in production) ───────────────────────────────
JWT_SECRET=super-secret-jwt-token-for-local-dev-only

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Embedding provider (swap as needed) ──────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformer   # or: openai
EMBEDDING_MODEL=all-MiniLM-L6-v2          # local default (d_s=384)
# EMBEDDING_MODEL=text-embedding-3-small  # OpenAI (d_s=1536)
OPENAI_API_KEY=                           # required if EMBEDDING_PROVIDER=openai

# ── Cortex ────────────────────────────────────────────────────────────────────
BIOMORPHIC_MODE=learning                  # learning | execution
ACCURACY_THRESHOLD=0.85
ACCURACY_WINDOW_DAYS=30
